generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  role               String              @default("PATIENT")
  isDeleted          Boolean             @default(false)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  notifications      Notification[]
  payments           Payment[]
  profile            Profile?
  serviceRequests    ServiceRequest[]
  patientShifts      Shift[]             @relation("PatientShifts")
  caregiverShifts    Shift[]             @relation("CaregiverShifts")
  withdrawalRequests WithdrawalRequest[]
  verificationDocs   VerificationDoc[]
  reviews            Review[]

  @@index([role, isDeleted])
}

model VerificationDoc {
  id        String   @id @default(uuid())
  userId    String
  title     String   // "ID Card", "Nursing License", "Passport", etc.
  docUrl    String
  status    String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  expiryDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  firstName        String
  lastName         String
  phone            String?
  address          String?
  bio              String?
  ailment          String?
  medicalHistory   String?
  age              Int?
  gender           String?
  location         String?
  emergencyContact String?
  preferredShift   String?
  isVerified       Boolean  @default(false)
  cvVerified       Boolean  @default(false)
  idVerified       Boolean  @default(false)
  licenseVerified  Boolean  @default(false) // New for v2
  skills           String?
  idNumber         String?
  experienceYears  Int?
  availability     String?
  availabilityDetails String? // JSON: { day: true, evening: false, weekend: true }
  hourlyRate       Decimal?
  desiredSalary    Decimal?
  crimeConviction  Boolean  @default(false)
  certifications   String?
  cvUrl            String?
  certificateUrl   String?
  idCardUrl        String?
  height           Float?
  weight           Float?
  insuranceNumber  String?
  targetDepartments String? // Comma-separated or JSON
  serviceLocation  String? // My Own Home, Caregiver's Home, etc.
  servicePreference String? // In Home of Client, etc.
  isPremium        Boolean  @default(false)
  paymentStatus    String   @default("PENDING")
  balance          Decimal  @default(0)
  totalBilled      Decimal  @default(0)
  totalPaid        Decimal  @default(0)
  lastLatitude     Float?
  lastLongitude    Float?
  locationUpdatedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@index([isVerified])
}

model Shift {
  id             String    @id @default(uuid())
  caregiverId    String?
  patientId      String
  requestId      String?   @unique
  startTime      DateTime
  endTime        DateTime
  shiftType      String    @default("24HR")
  status         String    @default("ASSIGNED") // ASSIGNED, ACCEPTED, IN_PROGRESS, COMPLETED, PAID
  notes          String?
  clockInTime    DateTime?
  clockOutTime   DateTime?
  actualDuration Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  earnings       Decimal?
  report         Report?   // High level final report
  clinicalLogs   ClinicalLog[] // Multiple updates during shift
  paymentId      String?   @unique
  patient        User      @relation("PatientShifts", fields: [patientId], references: [id])
  caregiver      User?     @relation("CaregiverShifts", fields: [caregiverId], references: [id])
  serviceRequest ServiceRequest? @relation(fields: [requestId], references: [id])

  @@index([status])
}

model ClinicalLog {
  id                 String   @id @default(uuid())
  shiftId            String
  content            String // General summary
  servicesRendered   String? // Bathing, dressing, etc.
  pulse              String?
  temperature        String?
  respiration        String?
  bloodPressure      String?
  nutritionHydration String?
  eliminationDetails String?
  safetyEnvironment  String?
  vitals             String? // Legacy JSON backup
  loggedAt           DateTime @default(now())
  shift              Shift    @relation(fields: [shiftId], references: [id])
}

model Report {
  id        String   @id @default(uuid())
  shiftId   String   @unique
  content   String
  vitals    String?
  createdAt DateTime @default(now())
  shift     Shift    @relation(fields: [shiftId], references: [id])
}

model ServiceRequest {
  id               String   @id @default(uuid())
  patientId        String
  careType         String
  duration         String
  location         String
  status           String   @default("PENDING") // PENDING, PRICED, PAID, COMPLETED
  description      String?
  price            Decimal? @default(0)
  amountPaid       Decimal? @default(0)
  remainingBalance Decimal? @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patientAilment   String?
  patient          User     @relation(fields: [patientId], references: [id])
  shift            Shift?

  @@index([status])
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  requestId     String?
  shiftId       String?
  amount        Decimal
  transactionId String?  @unique
  mpesaReceipt  String?
  phoneNumber   String
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  type          String   @default("STK_PUSH") // STK_PUSH, ADMIN_PAYOUT
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  caregiverId String
  amount      Decimal
  mpesaNumber String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  payoutId    String?  // Reference to Payment object if completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  caregiver   User     @relation(fields: [caregiverId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
