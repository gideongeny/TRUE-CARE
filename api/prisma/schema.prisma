generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  role               String              @default("PATIENT")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  notifications      Notification[]
  payments           Payment[]
  profile            Profile?
  serviceRequests    ServiceRequest[]
  patientShifts      Shift[]             @relation("PatientShifts")
  caregiverShifts    Shift[]             @relation("CaregiverShifts")
  withdrawalRequests WithdrawalRequest[]
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  firstName        String
  lastName         String
  phone            String?
  address          String?
  bio              String?
  ailment          String?
  medicalHistory   String?
  age              Int?
  gender           String?
  location         String?
  emergencyContact String?
  preferredShift   String?
  isVerified       Boolean  @default(false)
  cvVerified       Boolean  @default(false)
  idVerified       Boolean  @default(false)
  skills           String?
  idNumber         String?
  experienceYears  Int?
  availability     String?
  hourlyRate       Decimal?
  cvUrl            String?
  certificateUrl   String?
  idCardUrl        String?
  paymentStatus    String   @default("PENDING")
  balance          Decimal  @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

model Shift {
  id             String    @id @default(uuid())
  caregiverId    String?
  patientId      String
  startTime      DateTime
  endTime        DateTime
  shiftType      String    @default("24HR")
  status         String    @default("SCHEDULED")
  notes          String?
  clockInTime    DateTime?
  clockOutTime   DateTime?
  actualDuration Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  earnings       Decimal?
  report         Report?
  patient        User      @relation("PatientShifts", fields: [patientId], references: [id])
  caregiver      User?     @relation("CaregiverShifts", fields: [caregiverId], references: [id])
}

model Report {
  id        String   @id @default(uuid())
  shiftId   String   @unique
  content   String
  vitals    String?
  createdAt DateTime @default(now())
  shift     Shift    @relation(fields: [shiftId], references: [id])
}

model ServiceRequest {
  id             String   @id @default(uuid())
  patientId      String
  careType       String
  duration       String
  location       String
  status         String   @default("PENDING")
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  patientAilment String?
  patient        User     @relation(fields: [patientId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  amount        Decimal
  transactionId String?  @unique
  mpesaReceipt  String?
  phoneNumber   String
  status        String   @default("PENDING")
  type          String   @default("STK_PUSH")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  caregiverId String
  amount      Decimal
  mpesaNumber String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  caregiver   User     @relation(fields: [caregiverId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
