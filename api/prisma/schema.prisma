generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support enums, using Strings
// Role: ADMIN, CAREGIVER, PATIENT
// ShiftStatus: SCHEDULED, COMPLETED, CANCELLED, IN_PROGRESS
// RequestStatus: PENDING, APPROVED, REJECTED

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("PATIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile?
  
  // Relations
  caregiverShifts Shift[] @relation("CaregiverShifts")
  patientShifts   Shift[] @relation("PatientShifts")
  
  serviceRequests ServiceRequest[]
  payments        Payment[]
  withdrawalRequests WithdrawalRequest[]
  notifications   Notification[]
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  phone     String?
  address   String?
  bio       String?
  
  // Medical Info (For Patients)
  ailment       String?
  medicalHistory String?
  age           Int?
  gender        String? // MALE, FEMALE, OTHER
  location      String?
  emergencyContact String?
  preferredShift   String? // DAY, NIGHT, 24HR

  // Caregiver specific
  isVerified      Boolean @default(false)
  cvVerified      Boolean @default(false)
  idVerified      Boolean @default(false)
  skills          String? 
  idNumber        String?
  experienceYears Int?
  availability    String? // DAY, NIGHT, BOTH
  hourlyRate      Decimal?
  
  // Documents
  cvUrl          String?
  certificateUrl String?
  idCardUrl      String?

  // Financial Info
  paymentStatus String @default("PENDING") // PENDING, PAID, OVERDUE
  balance       Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id          String      @id @default(uuid())
  caregiverId String?
  caregiver   User?       @relation("CaregiverShifts", fields: [caregiverId], references: [id])
  patientId   String
  patient     User        @relation("PatientShifts", fields: [patientId], references: [id])
  
  startTime   DateTime
  endTime     DateTime
  shiftType   String      @default("24HR") // DAY, NIGHT, 24HR
  status      String      @default("SCHEDULED")
  notes       String?
  
  clockInTime    DateTime?
  clockOutTime   DateTime?
  actualDuration Float?     // In hours
  earnings       Decimal?   // Earnings for this specific shift

  report         Report?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id        String   @id @default(uuid())
  shiftId   String   @unique
  shift     Shift    @relation(fields: [shiftId], references: [id])
  content   String
  vitals    String?  
  createdAt DateTime @default(now())
}

model ServiceRequest {
  id        String        @id @default(uuid())
  patientId String
  patient   User          @relation(fields: [patientId], references: [id])
  
  careType       String
  patientAilment String?
  duration       String
  location       String
  status         String        @default("PENDING")
  description    String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amount        Decimal
  transactionId String?  @unique
  mpesaReceipt  String?
  phoneNumber   String
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  type          String   @default("STK_PUSH")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  caregiverId String
  caregiver   User     @relation(fields: [caregiverId], references: [id])
  amount      Decimal
  mpesaNumber String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String?  // SHIFT, PAYMENT, SYSTEM
  
  createdAt DateTime @default(now())
}
