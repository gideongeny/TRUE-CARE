<?xml version="1.0" encoding="utf-8"?> 
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello, Francis"
                        android:textColor="@color/med_text_primary"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your health is our priority."
                        android:textColor="@color/med_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/ic_medical_brand"
                    android:padding="8dp"
                    android:background="@color/med_soft_gray"
                    android:clickable="true"
                    android:focusable="true"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent"
                    app:strokeColor="@color/med_soft_gray_dark"
                    app:strokeWidth="1dp" />
            </RelativeLayout>

            <!-- Health Snapshot Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health Snapshot"
                android:textColor="@color/med_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_soft_card"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity"
                        android:textColor="@color/med_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:textAllCaps="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8,432"
                        android:textColor="@color/med_teal_primary"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="steps today"
                        android:textColor="@color/med_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_soft_card"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sleep"
                        android:textColor="@color/med_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:textAllCaps="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7h 20m"
                        android:textColor="@color/med_mint_success"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="rested state"
                        android:textColor="@color/med_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Assigned Caregiver Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Member assigned to you"
                android:textColor="@color/med_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="16dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_medical_brand"
                        android:padding="8dp"
                        android:background="@color/med_mint_soft"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dr. Sarah Wilson"
                            android:textColor="@color/med_text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-black" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Senior Clinical Caregiver"
                            android:textColor="@color/med_text_secondary"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: Active on Shift"
                            android:textColor="@color/med_teal_primary"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-black"
                            android:textAllCaps="true"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_pill_button"
                        android:src="@android:drawable/ic_menu_call"
                        android:tint="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Upcoming Visit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_card"
                android:padding="24dp"
                android:orientation="vertical"
                android:layout_marginBottom="32dp"
                android:elevation="2dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upcoming Visit"
                        android:textColor="@color/med_text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:text="TOMORROW"
                        android:textColor="@color/med_rose_error"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-black"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:background="@color/med_soft_gray" />
                </RelativeLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_today"
                        android:tint="@color/med_teal_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oct 24, 09:00 AM - 05:00 PM"
                        android:textColor="@color/med_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Payment Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/med_blue_bg"
                android:padding="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp"
                android:elevation="0dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balance Due"
                        android:textColor="@color/med_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:textAllCaps="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KES 2,400.00"
                        android:textColor="@color/med_text_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pay Now"
                    app:cornerRadius="24dp"
                    app:backgroundTint="@color/med_teal_primary"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-black"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- New Request Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewRequest"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="+ Book New Service"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/med_text_primary"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-black"
                android:textSize="14sp"
                app:elevation="8dp"
                android:layout_marginBottom="32dp" />

            <!-- Recent Requests List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Requests"
                android:textColor="@color/med_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Bottom Navigation -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        app:cardCornerRadius="36dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/med_text_primary">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/white" />
            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_today"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/med_text_secondary" />
            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@android:drawable/ic_popup_reminder"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/med_text_secondary" />
            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_view"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/med_text_secondary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
