<?xml version="1.0" encoding="utf-8"?>
<!-- V3 Patient Home Fragment -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Teal Hero Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/teal_primary"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="52dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPASSIONATE CARE"
                android:textColor="#B2F5EA"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.2"/>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your clinical dashboard is synced."
                android:textColor="#B2F5EA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Body content overlapping header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="-36dp">

            <!-- Premium Promo Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvPremiumPromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/premium_gradient_bg"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPGRADE TO PREMIUM"
                        android:textColor="#FFD700"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unlock Full Command & Control"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginTop="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Access advanced scheduling, priority verification, and detailed medical analytics."
                        android:textColor="#E2E8F0"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"/>
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Upgrade Now"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textColor="@color/white"
                        app:backgroundTint="#2D3748"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Active Assignment card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MY ACTIVE CARE"
                        android:textColor="@color/teal_primary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.15"/>

                    <TextView
                        android:id="@+id/tvActiveCaregiver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Active Assignment"
                        android:textColor="@color/slate_900"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvActiveCaregiverRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book a care session to get started"
                        android:textColor="@color/slate_500"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Actions Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                android:textColor="@color/slate_500"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginBottom="24dp">

                <!-- Book Care -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewRequest"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Book Care"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/teal_primary"
                    app:cornerRadius="20dp"
                    app:elevation="4dp"/>

                <!-- Health History -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHealthHistory"
                    style="@style/Widget.TrueCare.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Health History"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black"
                    app:cornerRadius="20dp"/>

                <!-- Payments -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayments"
                    style="@style/Widget.TrueCare.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Payments"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black"
                    app:cornerRadius="20dp"/>

                <!-- Notifications -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotifications"
                    style="@style/Widget.TrueCare.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Alerts"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black"
                    app:cornerRadius="20dp"/>
            </GridLayout>

            <!-- My Requests List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY CARE REQUESTS"
                android:textColor="@color/slate_500"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
