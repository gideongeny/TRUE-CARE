<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Dynamic Welcome Header -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back"
            android:textColor="@color/med_text_primary"
            android:textSize="24sp"
            android:fontFamily="sans-serif-black" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your clinical dashboard is synchronized."
            android:textColor="@color/med_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- Quick Summary Card (Dynamic) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@color/med_blue_bg">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE NODE"
                    android:textColor="@color/med_text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-black"
                    android:textAllCaps="true" />
                <TextView
                    android:id="@+id/tvActiveCaregiver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Active Assignment"
                    android:textColor="@color/med_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- New Request Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewRequest"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="+ Book New Clinical Service"
            app:cornerRadius="32dp"
            app:backgroundTint="@color/med_text_primary"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            android:textSize="14sp"
            app:elevation="8dp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHealthHistory"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="View Health History"
            app:cornerRadius="32dp"
            app:backgroundTint="#F3F4F6"
            android:textColor="#374151"
            android:fontFamily="sans-serif-black"
            android:textSize="14sp"
            app:elevation="2dp"
            android:layout_marginBottom="32dp" />

        <!-- Recent Activity Registry -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clinical Activity Registry"
            android:textColor="@color/med_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
