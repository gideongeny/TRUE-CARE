<?xml version="1.0" encoding="utf-8"?> 
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <!-- Header -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_medical_brand"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join TrueCare"
            android:textColor="@color/med_text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/ivLogo"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your journey to better care starts here."
            android:textColor="@color/med_text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Core Fields Container -->
        <LinearLayout
            android:id="@+id/layoutCoreFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <!-- Name -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_edit_text_soft"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="20dp"
                android:textColor="@color/med_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Email -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_edit_text_soft"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="20dp"
                android:textColor="@color/med_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Phone -->
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_edit_text_soft"
                android:hint="Phone Number"
                android:inputType="phone"
                android:paddingHorizontal="20dp"
                android:textColor="@color/med_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Password -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_edit_text_soft"
                android:hint="Create Password"
                android:inputType="textPassword"
                android:paddingHorizontal="20dp"
                android:textColor="@color/med_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- Role Selection Toggle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I AM REGISTERING AS:"
                android:textColor="@color/med_text_secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_soft_card"
                android:padding="4dp">
                <RadioButton
                    android:id="@+id/rbPatient"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Patient"
                    android:button="@null"
                    android:gravity="center"
                    android:checked="true"
                    android:background="@drawable/bg_pill_button"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-bold" />
                <RadioButton
                    android:id="@+id/rbCaregiver"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Caregiver"
                    android:button="@null"
                    android:gravity="center"
                    android:textColor="@color/med_text_secondary"
                    android:fontFamily="sans-serif-bold" />
            </RadioGroup>
        </LinearLayout>

        <!-- Dynamic Role Fields -->
        <FrameLayout
            android:id="@+id/roleFieldsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutCoreFields">

            <!-- Patient Specific -->
            <LinearLayout
                android:id="@+id/llPatientFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_edit_text_soft"
                    android:hint="Age"
                    android:inputType="number"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="12dp" />
                <EditText
                    android:id="@+id/etCondition"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_edit_text_soft"
                    android:hint="Condition / Illness"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="12dp" />
                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_edit_text_soft"
                    android:hint="Full Address / Location"
                    android:paddingHorizontal="20dp" />
            </LinearLayout>

            <!-- Caregiver Specific (Hidden by default) -->
            <LinearLayout
                android:id="@+id/llCaregiverFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <EditText
                    android:id="@+id/etIdNumber"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_edit_text_soft"
                    android:hint="National ID Number"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadCv"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Upload CV"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:cornerRadius="16dp"
                        android:layout_marginEnd="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadCert"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Certificates"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:cornerRadius="16dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Finalize -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="CREATE SECURE ACCOUNT"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            app:backgroundTint="@color/med_teal_primary"
            app:cornerRadius="32dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/roleFieldsContainer" />

        <TextView
            android:id="@+id/tvLoginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Sign In"
            android:textColor="@color/med_teal_primary"
            android:fontFamily="sans-serif-bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="48dp"
            app:layout_constraintTop_toBottomOf="@id/btnRegister"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/btnRegister"
            app:layout_constraintBottom_toBottomOf="@id/btnRegister"
            app:layout_constraintStart_toStartOf="@id/btnRegister"
            app:layout_constraintEnd_toEndOf="@id/btnRegister" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
