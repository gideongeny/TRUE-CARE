<?xml version="1.0" encoding="utf-8"?>
<!-- V3 Compassionate Care Splash Screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/teal_primary"
    android:padding="40dp">

    <!-- Logo circle -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardCornerRadius="40dp"
        app:cardBackgroundColor="#FFFFFFFF"
        app:cardElevation="16dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_medical_brand"
            android:scaleType="centerInside"
            android:padding="24dp"/>
    </androidx.cardview.widget.CardView>

    <!-- App name -->
    <TextView
        android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TRUE CARE"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.15"
        android:layout_marginTop="28dp"/>

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COMPASSIONATE HEALTHCARE — REDEFINED"
        android:textColor="#B2F5EA"
        android:textSize="10sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.2"
        android:layout_marginTop="8dp"/>

    <!-- Pulse dots loader -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:layout_gravity="center">

        <View
            android:id="@+id/dot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#80FFFFFF"
            android:layout_margin="5dp"/>

        <View
            android:id="@+id/dot2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#CCFFFFFF"
            android:layout_margin="5dp"/>

        <View
            android:id="@+id/dot3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#80FFFFFF"
            android:layout_margin="5dp"/>
    </LinearLayout>

    <!-- Version text at bottom -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v3.0 • Secure Clinical Platform"
        android:textColor="#7DD3CC"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        android:layout_marginTop="48dp"/>

</LinearLayout>
