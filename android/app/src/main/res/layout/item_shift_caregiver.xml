<?xml version="1.0" encoding="utf-8"?>
<!-- V3 Shift item card for RecyclerViews -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <!-- Teal left accent bar -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/teal_primary"
            android:layout_marginEnd="16dp"/>

        <!-- Shift info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShiftPatient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Name"
                android:textColor="@color/slate_900"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/tvShiftType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day Shift • 8 Hours"
                android:textColor="@color/teal_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvShiftDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textColor="@color/slate_400"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvShiftAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KSh 0.00"
                android:textColor="@color/teal_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Status chip -->
        <TextView
            android:id="@+id/tvShiftStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@color/teal_light"
            android:textColor="@color/teal_dark"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
