<?xml version="1.0" encoding="utf-8"?>
<!-- V3 Clinical History — Vertical Timeline -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/slate_50">

    <!-- Teal App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/teal_primary"
        app:title="Health Timeline"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/white"/>

    <!-- Filter chip row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Records"
                android:checked="true"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipVitals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vitals"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clinical Notes"
                style="@style/Widget.Material3.Chip.Filter"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Timeline list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClinicalHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:paddingTop="8dp"/>

</LinearLayout>
